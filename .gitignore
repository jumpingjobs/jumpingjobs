# Generated per-harness output — NOT committed. source/skills/ is the only copy in git.
# Regenerate locally with `npm run build`; `prepublishOnly` regenerates it for the npm
# tarball, so published packages always ship all harnesses.
# (The native Claude plugin reads source/skills/ directly — see .claude-plugin/plugin.json —
# so no generated tree needs to be committed for the marketplace install path.)
.claude/skills/
